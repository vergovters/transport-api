								"routes",
								"{{route_id}}",
								"start"
							]
						},
						"description": "Start route execution (ASSIGNED → IN_PROGRESS)"
					}
				},
				{
					"name": "Complete Route",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "x-api-key",
